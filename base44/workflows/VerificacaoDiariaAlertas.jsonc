{
  "description": "Roda a verifica\u00e7\u00e3o de alertas autom\u00e1ticos uma vez por dia (contratos, preventivas, SLA, estoque e chamados), mesmo com o app fechado.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "verificacao_diaria_alertas",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verificar_alertas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verificarAlertas",
            "args": {
              "origem": "rotina_diaria"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar alertas",
            "description": "Contratos, preventivas, SLA, estoque"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "VerificacaoDiariaAlertas"
}