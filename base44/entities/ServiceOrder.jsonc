{
  "name": "ServiceOrder",
  "properties": {
    "attachments": {
      "description": "Anexos e fotos",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "code": {
      "description": "C\u00f3digo da OS (gerado automaticamente)",
      "type": "string"
    },
    "completion_date": {
      "description": "Data/hora da conclus\u00e3o. Equivale a hora_fim da Parte C \u2014 preenchido automaticamente ao clicar 'Finalizar Manuten\u00e7\u00e3o'.",
      "format": "date-time",
      "type": "string"
    },
    "duracao_total_minutos": {
      "description": "Calculado a partir de completion_date - start_date ao finalizar. Edit\u00e1vel manualmente em caso de ajuste. Usado no c\u00e1lculo autom\u00e1tico de MTTR (MaintenancePlan.mttr_hours).",
      "type": "number"
    },
    "equipment_criticality": {
      "description": "Criticidade do equipamento (copiada do cadastro no momento da abertura) \u2014 usada para sugerir a prioridade automaticamente. N\u00e3o editar manualmente.",
      "enum": [
        "Suporte \u00e0 Vida",
        "Terap\u00eautico",
        "Diagn\u00f3stico",
        "Apoio"
      ],
      "type": "string"
    },
    "equipment_id": {
      "description": "ID do equipamento vinculado",
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome do equipamento (cache)",
      "type": "string"
    },
    "execution_by": {
      "default": "Equipe Interna",
      "description": "Execu\u00e7\u00e3o por",
      "enum": [
        "Equipe Interna",
        "Fornecedor Externo"
      ],
      "type": "string"
    },
    "open_date": {
      "description": "Data/hora de abertura",
      "format": "date-time",
      "type": "string"
    },
    "origin": {
      "default": "Manual",
      "description": "Origem do chamado. 'Agendada' = gerada automaticamente pelo job de preventiva quando Equipment.data_proxima_preventiva vence (Parte C.5); nesse caso type deve ser fixado em 'Preventiva' automaticamente, sem escolha do usu\u00e1rio.",
      "enum": [
        "Manual",
        "Agendada",
        "Sugerida por IA"
      ],
      "type": "string"
    },
    "parts_used": {
      "description": "Pe\u00e7as e insumos utilizados nesta OS (equivale a pecas_utilizadas da Parte C). Ao salvar, current_stock da SparePart referenciada deve ser decrementado pela quantity.",
      "items": {
        "properties": {
          "cost": {
            "type": "number"
          },
          "name": {
            "description": "Nome da pe\u00e7a (cache, copiado de SparePart no momento do uso)",
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "spare_part_id": {
            "description": "ID da pe\u00e7a \u2014 deve referenciar um registro real da entidade SparePart. Ao salvar, o current_stock dessa pe\u00e7a deve ser decrementado pela quantity informada.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "periodicidade_referencia": {
      "description": "Preenchido apenas quando type = Preventiva: guarda o valor de Equipment.periodicidade_preventiva_dias vigente no momento em que esta OS preventiva foi gerada (hist\u00f3rico, caso a periodicidade mude depois).",
      "type": "number"
    },
    "prioridade_score_equipamento": {
      "description": "Cache do Equipment.prioridade_score (Fennigkoh & Smith/EMR) no momento da abertura desta OS. Usado para ordenar a Central de Manuten\u00e7\u00f5es por prioridade (Parte C.6).",
      "type": "number"
    },
    "priority": {
      "default": "M\u00e9dia",
      "description": "Prioridade \u2014 sugerida automaticamente a partir de equipment_criticality, mas pode ser sobrescrita manualmente (registrar motivo em priority_override_reason)",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ],
      "type": "string"
    },
    "priority_override_reason": {
      "description": "Justificativa obrigat\u00f3ria quando a prioridade \u00e9 alterada manualmente e diverge da sugest\u00e3o baseada na criticidade do equipamento",
      "type": "string"
    },
    "problem_description": {
      "description": "Descri\u00e7\u00e3o do problema",
      "type": "string"
    },
    "requester_id": {
      "description": "ID do solicitante \u2014 deve referenciar um registro real da entidade User (n\u00e3o usar texto livre)",
      "type": "string"
    },
    "requester_name": {
      "description": "Nome do solicitante (cache)",
      "type": "string"
    },
    "response_time_minutes": {
      "description": "Tempo de atendimento/resposta: start_date - open_date, em minutos. Calculado automaticamente ao clicar 'Iniciar Manuten\u00e7\u00e3o'. Diferente de duracao_total_minutos (que mede a execu\u00e7\u00e3o do reparo em si) \u2014 este mede quanto tempo o chamado ficou esperando ser iniciado.",
      "type": "number"
    },
    "scheduled_date": {
      "description": "Data/hora de agendamento",
      "format": "date-time",
      "type": "string"
    },
    "sector": {
      "description": "Setor de origem",
      "type": "string"
    },
    "sla_deadline": {
      "description": "Prazo limite de RESOLU\u00c7\u00c3O calculado (open_date + sla_resolution_hours do Contract vinculado ao equipamento). Null quando n\u00e3o h\u00e1 contrato/SLA aplic\u00e1vel.",
      "format": "date-time",
      "type": "string"
    },
    "sla_response_deadline": {
      "description": "Prazo limite de PRIMEIRO ATENDIMENTO calculado (open_date + sla_response_hours do Contract vinculado ao equipamento). Distinto de sla_deadline, que \u00e9 o prazo de resolu\u00e7\u00e3o completa. Null quando n\u00e3o h\u00e1 contrato/SLA aplic\u00e1vel.",
      "format": "date-time",
      "type": "string"
    },
    "sla_response_status": {
      "default": "Sem SLA Definido",
      "description": "Status do cumprimento do SLA de primeiro atendimento, comparando start_date (ou agora, se ainda n\u00e3o iniciado) com sla_response_deadline.",
      "enum": [
        "Dentro do Prazo",
        "Atrasado",
        "Sem SLA Definido"
      ],
      "type": "string"
    },
    "sla_status": {
      "default": "Sem SLA Definido",
      "description": "Status do cumprimento do SLA de resolu\u00e7\u00e3o, calculado comparando a data atual (ou completion_date) com sla_deadline",
      "enum": [
        "Dentro do Prazo",
        "Atrasado",
        "Sem SLA Definido"
      ],
      "type": "string"
    },
    "start_date": {
      "description": "Data/hora do in\u00edcio do atendimento. Equivale a hora_inicio da Parte C \u2014 preenchido automaticamente ao clicar 'Iniciar Manuten\u00e7\u00e3o'.",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "Novo",
      "description": "Status da OS. Mapeamento para a vis\u00e3o simplificada da Central de Manuten\u00e7\u00f5es (Parte C.6): 'pendente' = Novo/Aguardando Pe\u00e7a/Aguardando Fornecedor/Pendente; 'em_andamento' = Em Andamento; 'concluida' = Conclu\u00eddo.",
      "enum": [
        "Novo",
        "Em Andamento",
        "Aguardando Pe\u00e7a",
        "Aguardando Fornecedor",
        "Pendente",
        "Conclu\u00eddo"
      ],
      "type": "string"
    },
    "supplier_rating": {
      "description": "Nota do fornecedor (1-5)",
      "type": "number"
    },
    "technical_report": {
      "description": "Laudo t\u00e9cnico. Equivale a descricao_realizada da Parte C \u2014 obrigat\u00f3rio ao finalizar a manuten\u00e7\u00e3o.",
      "type": "string"
    },
    "technician_id": {
      "description": "ID do t\u00e9cnico respons\u00e1vel \u2014 deve referenciar um registro real da entidade TechTeam (n\u00e3o usar c\u00f3digos avulsos como 'tech-001')",
      "type": "string"
    },
    "technician_name": {
      "description": "Nome do t\u00e9cnico respons\u00e1vel (cache)",
      "type": "string"
    },
    "total_cost": {
      "description": "Custo total",
      "type": "number"
    },
    "type": {
      "description": "Tipo de servi\u00e7o. Para Preventiva/Corretiva, equivale a tipo_manutencao da Parte C: deve ser definido automaticamente pela origem (Preventiva = gerada pelo job de periodicidade; Corretiva = chamado reportado por usu\u00e1rio), n\u00e3o escolhido livremente pelo usu\u00e1rio quando origin for 'Agendada'. Calibra\u00e7\u00e3o e Instala\u00e7\u00e3o continuam de sele\u00e7\u00e3o manual.",
      "enum": [
        "Preventiva",
        "Corretiva",
        "Calibra\u00e7\u00e3o",
        "Instala\u00e7\u00e3o"
      ],
      "type": "string"
    }
  },
  "required": [
    "type",
    "equipment_id",
    "problem_description"
  ],
  "type": "object"
}