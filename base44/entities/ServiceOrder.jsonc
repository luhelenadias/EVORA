{
  "name": "ServiceOrder",
  "properties": {
    "attachments": {
      "description": "Anexos e fotos",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "campos_revisar": {
      "description": "Chaves de campo que a IA n\u00e3o teve certeza ao gerar o rascunho a partir do \u00e1udio (ex.: 'pecas', 'causa_falha'). A interface marca esses campos como 'revisar' at\u00e9 o t\u00e9cnico confirmar.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "causa_falha": {
      "description": "Diagn\u00f3stico e causa prov\u00e1vel da falha, informados pelo t\u00e9cnico (digitados ou gerados a partir do relato em \u00e1udio e revisados por ele).",
      "type": "string"
    },
    "code": {
      "description": "C\u00f3digo da OS (gerado automaticamente)",
      "type": "string"
    },
    "completion_date": {
      "description": "Data/hora da conclus\u00e3o. Equivale a hora_fim da Parte C \u2014 preenchido automaticamente ao clicar 'Finalizar Manuten\u00e7\u00e3o'.",
      "format": "date-time",
      "type": "string"
    },
    "contrato_id": {
      "description": "ID do Contract que fundamenta a rota de atendimento (garantia ou cobertura contratual). Vazio quando a rota \u00e9 'Equipe interna' ou 'Fornecedor sem contrato'.",
      "type": "string"
    },
    "duracao_total_minutos": {
      "description": "Calculado a partir de completion_date - start_date ao finalizar. Edit\u00e1vel manualmente em caso de ajuste. Usado no c\u00e1lculo autom\u00e1tico de MTTR (MaintenancePlan.mttr_hours).",
      "type": "number"
    },
    "equipment_criticality": {
      "description": "Criticidade do equipamento (copiada do cadastro no momento da abertura) \u2014 usada para sugerir a prioridade automaticamente. N\u00e3o editar manualmente.",
      "enum": [
        "Suporte \u00e0 Vida",
        "Terap\u00eautico",
        "Diagn\u00f3stico",
        "Apoio"
      ],
      "type": "string"
    },
    "equipment_id": {
      "description": "ID do equipamento vinculado",
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome do equipamento (cache)",
      "type": "string"
    },
    "execution_by": {
      "default": "Equipe Interna",
      "description": "Execu\u00e7\u00e3o por. 'Fornecedor Externo' = manuten\u00e7\u00e3o encaminhada ao fabricante/servi\u00e7o externo, sem t\u00e9cnico interno designado (technician_id vazio e nome em fornecedor_nome). Definido na triagem pela rota de atendimento.",
      "enum": [
        "Equipe Interna",
        "Fornecedor Externo"
      ],
      "type": "string"
    },
    "fornecedor_nome": {
      "description": "Nome do fabricante ou servi\u00e7o externo de manuten\u00e7\u00e3o respons\u00e1vel pela OS quando execution_by = 'Fornecedor Externo'. Nesse caso n\u00e3o h\u00e1 t\u00e9cnico interno designado.",
      "type": "string"
    },
    "open_date": {
      "description": "Data/hora de abertura",
      "format": "date-time",
      "type": "string"
    },
    "origin": {
      "default": "Manual",
      "description": "Origem do chamado. 'Agendada' = gerada automaticamente pelo job de preventiva quando Equipment.data_proxima_preventiva vence (Parte C.5); nesse caso type deve ser fixado em 'Preventiva' automaticamente, sem escolha do usu\u00e1rio.",
      "enum": [
        "Manual",
        "Agendada",
        "Sugerida por IA"
      ],
      "type": "string"
    },
    "parts_used": {
      "description": "Pe\u00e7as e insumos utilizados nesta OS (equivale a pecas_utilizadas da Parte C). Ao salvar, current_stock da SparePart referenciada deve ser decrementado pela quantity.",
      "items": {
        "properties": {
          "cost": {
            "type": "number"
          },
          "name": {
            "description": "Nome da pe\u00e7a (cache, copiado de SparePart no momento do uso)",
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "spare_part_id": {
            "description": "ID da pe\u00e7a \u2014 deve referenciar um registro real da entidade SparePart. Ao salvar, o current_stock dessa pe\u00e7a deve ser decrementado pela quantity informada.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "pendencias": {
      "description": "O que ficou pendente no atendimento (pe\u00e7a em falta, retorno programado, acompanhamento), a partir do relato do t\u00e9cnico.",
      "type": "string"
    },
    "periodicidade_referencia": {
      "description": "Preenchido apenas quando type = Preventiva: guarda o valor de Equipment.periodicidade_preventiva_dias vigente no momento em que esta OS preventiva foi gerada (hist\u00f3rico, caso a periodicidade mude depois).",
      "type": "number"
    },
    "prioridade_score_equipamento": {
      "description": "Cache do Equipment.prioridade_score (Fennigkoh & Smith/EMR) no momento da abertura desta OS. Usado para ordenar a Central de Manuten\u00e7\u00f5es por prioridade (Parte C.6).",
      "type": "number"
    },
    "priority": {
      "default": "M\u00e9dia",
      "description": "Prioridade final da OS: sugest\u00e3o pela criticidade do equipamento, confirmada ou alterada na triagem. Altera\u00e7\u00e3o que diverge da sugest\u00e3o exige motivo em priority_override_reason.",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ],
      "type": "string"
    },
    "priority_override_reason": {
      "description": "Justificativa obrigat\u00f3ria quando a prioridade \u00e9 alterada manualmente e diverge da sugest\u00e3o baseada na criticidade do equipamento",
      "type": "string"
    },
    "problem_description": {
      "description": "Descri\u00e7\u00e3o do problema",
      "type": "string"
    },
    "relatorio_audio_em": {
      "description": "Data/hora em que o rascunho do relat\u00f3rio foi gerado por IA a partir do relato em \u00e1udio. Marca que os campos de texto da OS vieram de um rascunho aguardando revis\u00e3o do t\u00e9cnico.",
      "format": "date-time",
      "type": "string"
    },
    "requester_id": {
      "description": "ID do solicitante \u2014 deve referenciar um registro real da entidade User (n\u00e3o usar texto livre)",
      "type": "string"
    },
    "requester_name": {
      "description": "Nome do solicitante (cache)",
      "type": "string"
    },
    "response_time_minutes": {
      "description": "Tempo de atendimento/resposta: start_date - open_date, em minutos. Calculado automaticamente ao clicar 'Iniciar Manuten\u00e7\u00e3o'. Mantido como est\u00e1 para n\u00e3o quebrar o hist\u00f3rico; os tempos de triagem s\u00e3o medidos separadamente (triagem_em).",
      "type": "number"
    },
    "rota_alterada_motivo": {
      "description": "Justificativa curta informada na triagem quando a rota aceita difere da rota sugerida pelo sistema. Obrigat\u00f3ria na troca.",
      "type": "string"
    },
    "rota_atendimento": {
      "description": "Rota de atendimento definida na triagem da OS corretiva. Garantia, Contrato e Fornecedor sem contrato implicam execution_by = 'Fornecedor Externo'; Equipe interna mant\u00e9m a execu\u00e7\u00e3o interna. Vazio enquanto a OS aguarda triagem.",
      "enum": [
        "Garantia",
        "Contrato",
        "Equipe interna",
        "Fornecedor sem contrato"
      ],
      "type": "string"
    },
    "rota_motivo": {
      "description": "Motivo em uma linha da rota sugerida pelo sistema (ex.: 'Garantia vigente at\u00e9 12/03/2027' ou 'Coberto pelo contrato CT-2025-001').",
      "type": "string"
    },
    "rota_sugerida": {
      "description": "Rota que o sistema sugeriu na abertura da OS corretiva, preservada mesmo quando a gest\u00e3o escolhe outra rota na triagem.",
      "enum": [
        "Garantia",
        "Contrato",
        "Equipe interna",
        "Fornecedor sem contrato"
      ],
      "type": "string"
    },
    "scheduled_date": {
      "description": "Data/hora de agendamento",
      "format": "date-time",
      "type": "string"
    },
    "sector": {
      "description": "Setor de origem",
      "type": "string"
    },
    "sla_deadline": {
      "description": "Prazo limite de RESOLU\u00c7\u00c3O calculado (open_date + sla_resolution_hours do Contract vinculado ao equipamento). Null quando n\u00e3o h\u00e1 contrato/SLA aplic\u00e1vel.",
      "format": "date-time",
      "type": "string"
    },
    "sla_response_deadline": {
      "description": "Prazo limite de PRIMEIRO ATENDIMENTO calculado (open_date + sla_response_hours do Contract vinculado ao equipamento). Distinto de sla_deadline, que \u00e9 o prazo de resolu\u00e7\u00e3o completa. Null quando n\u00e3o h\u00e1 contrato/SLA aplic\u00e1vel.",
      "format": "date-time",
      "type": "string"
    },
    "sla_response_status": {
      "default": "Sem SLA Definido",
      "description": "Status do cumprimento do SLA de primeiro atendimento, comparando start_date (ou agora, se ainda n\u00e3o iniciado) com sla_response_deadline.",
      "enum": [
        "Dentro do Prazo",
        "Atrasado",
        "Sem SLA Definido"
      ],
      "type": "string"
    },
    "sla_status": {
      "default": "Sem SLA Definido",
      "description": "Status do cumprimento do SLA de resolu\u00e7\u00e3o, calculado comparando a data atual (ou completion_date) com sla_deadline",
      "enum": [
        "Dentro do Prazo",
        "Atrasado",
        "Sem SLA Definido"
      ],
      "type": "string"
    },
    "start_date": {
      "description": "Data/hora do in\u00edcio do atendimento. Equivale a hora_inicio da Parte C \u2014 preenchido automaticamente ao clicar 'Iniciar Manuten\u00e7\u00e3o'.",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "Novo",
      "description": "Status da OS. 'Novo' significa 'Aguardando triagem' em uma OS corretiva ainda sem destino. Mapeamento para a vis\u00e3o simplificada da Central de Manuten\u00e7\u00f5es (Parte C.6): 'pendente' = Novo/Aguardando Pe\u00e7a/Aguardando Fornecedor/Aguardando Or\u00e7amento/Aguardando Aprova\u00e7\u00e3o/Aguardando Teste de Qualidade/Aguardando Aceite/Pendente; 'em_andamento' = Em Andamento/Em Transporte (ida)/Em Conserto Externo/Em Transporte (volta); 'concluida' = Conclu\u00eddo. Todo status diferente de Conclu\u00eddo \u00e9 considerado OS aberta.",
      "enum": [
        "Novo",
        "Em Andamento",
        "Aguardando Pe\u00e7a",
        "Aguardando Fornecedor",
        "Aguardando Or\u00e7amento",
        "Aguardando Aprova\u00e7\u00e3o",
        "Em Transporte (ida)",
        "Em Conserto Externo",
        "Em Transporte (volta)",
        "Aguardando Teste de Qualidade",
        "Aguardando Aceite",
        "Pendente",
        "Conclu\u00eddo"
      ],
      "type": "string"
    },
    "supplier_rating": {
      "description": "Nota do fornecedor (1-5)",
      "type": "number"
    },
    "technical_report": {
      "description": "Laudo t\u00e9cnico. Equivale a descricao_realizada da Parte C \u2014 obrigat\u00f3rio ao finalizar a manuten\u00e7\u00e3o.",
      "type": "string"
    },
    "technician_id": {
      "description": "ID do t\u00e9cnico respons\u00e1vel \u2014 deve referenciar um registro real da entidade User com perfil t\u00e9cnico (n\u00e3o usar c\u00f3digos avulsos como 'tech-001'). Definido na triagem (admin/gestor). Vazio quando a execu\u00e7\u00e3o \u00e9 externa ou enquanto a OS aguarda triagem.",
      "type": "string"
    },
    "technician_name": {
      "description": "Nome do t\u00e9cnico respons\u00e1vel (cache)",
      "type": "string"
    },
    "testes_finais": {
      "description": "Testes e medi\u00e7\u00f5es realizados ap\u00f3s o servi\u00e7o para validar o equipamento.",
      "type": "string"
    },
    "total_cost": {
      "description": "Custo total",
      "type": "number"
    },
    "transcricao_audio": {
      "description": "Transcri\u00e7\u00e3o bruta do relato em \u00e1udio do t\u00e9cnico. O \u00e1udio \u00e9 descartado ap\u00f3s a transcri\u00e7\u00e3o; aqui fica apenas o texto.",
      "type": "string"
    },
    "triagem_devolucao_motivo": {
      "description": "O que falta para a triagem seguir, quando a gest\u00e3o devolve o chamado a quem abriu. Enquanto estiver preenchido, a OS permanece 'Novo' com a marca\u00e7\u00e3o 'Devolvida para complemento'.",
      "type": "string"
    },
    "triagem_em": {
      "description": "Data/hora (do servidor) em que a triagem foi conclu\u00edda. Base dos indicadores 'espera at\u00e9 a triagem' (triagem_em - open_date) e 'triagem at\u00e9 o in\u00edcio' (start_date - triagem_em). OS antigas sem este campo ficam fora desses c\u00e1lculos.",
      "format": "date-time",
      "type": "string"
    },
    "triagem_por_id": {
      "description": "ID do usu\u00e1rio (admin ou gestor) que concluiu a triagem",
      "type": "string"
    },
    "triagem_por_nome": {
      "description": "Nome do usu\u00e1rio que concluiu a triagem (cache)",
      "type": "string"
    },
    "type": {
      "description": "Tipo de servi\u00e7o. Para Preventiva/Corretiva, equivale a tipo_manutencao da Parte C: deve ser definido automaticamente pela origem (Preventiva = gerada pelo job de periodicidade; Corretiva = chamado reportado por usu\u00e1rio), n\u00e3o escolhido livremente pelo usu\u00e1rio quando origin for 'Agendada'. Calibra\u00e7\u00e3o e Instala\u00e7\u00e3o continuam de sele\u00e7\u00e3o manual.",
      "enum": [
        "Preventiva",
        "Corretiva",
        "Calibra\u00e7\u00e3o",
        "Instala\u00e7\u00e3o"
      ],
      "type": "string"
    },
    "urgencia_percebida": {
      "description": "Urg\u00eancia percebida por quem abriu o chamado (opcional). \u00c9 uma sugest\u00e3o de quem relata o problema; a prioridade final (priority) \u00e9 confirmada na triagem.",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ],
      "type": "string"
    }
  },
  "required": [
    "type",
    "equipment_id",
    "problem_description"
  ],
  "type": "object"
}