{
  "name": "ServiceOrder",
  "properties": {
    "attachments": {
      "description": "Anexos e fotos",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "code": {
      "description": "C\u00f3digo da OS (gerado automaticamente)",
      "type": "string"
    },
    "completion_date": {
      "description": "Data/hora da conclus\u00e3o",
      "format": "date-time",
      "type": "string"
    },
    "equipment_criticality": {
      "description": "Criticidade do equipamento (copiada do cadastro no momento da abertura) \u2014 usada para sugerir a prioridade automaticamente. N\u00e3o editar manualmente.",
      "enum": [
        "Suporte \u00e0 Vida",
        "Terap\u00eautico",
        "Diagn\u00f3stico",
        "Apoio"
      ],
      "type": "string"
    },
    "equipment_id": {
      "description": "ID do equipamento vinculado",
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome do equipamento (cache)",
      "type": "string"
    },
    "execution_by": {
      "default": "Equipe Interna",
      "description": "Execu\u00e7\u00e3o por",
      "enum": [
        "Equipe Interna",
        "Fornecedor Externo"
      ],
      "type": "string"
    },
    "open_date": {
      "description": "Data/hora de abertura",
      "format": "date-time",
      "type": "string"
    },
    "origin": {
      "default": "Manual",
      "description": "Origem do chamado",
      "enum": [
        "Manual",
        "Agendada",
        "Sugerida por IA"
      ],
      "type": "string"
    },
    "parts_used": {
      "description": "Pe\u00e7as e insumos utilizados nesta OS",
      "items": {
        "properties": {
          "cost": {
            "type": "number"
          },
          "name": {
            "description": "Nome da pe\u00e7a (cache, copiado de SparePart no momento do uso)",
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "spare_part_id": {
            "description": "ID da pe\u00e7a \u2014 deve referenciar um registro real da entidade SparePart. Ao salvar, o current_stock dessa pe\u00e7a deve ser decrementado pela quantity informada.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "priority": {
      "default": "M\u00e9dia",
      "description": "Prioridade \u2014 sugerida automaticamente a partir de equipment_criticality, mas pode ser sobrescrita manualmente (registrar motivo em priority_override_reason)",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ],
      "type": "string"
    },
    "priority_override_reason": {
      "description": "Justificativa obrigat\u00f3ria quando a prioridade \u00e9 alterada manualmente e diverge da sugest\u00e3o baseada na criticidade do equipamento",
      "type": "string"
    },
    "problem_description": {
      "description": "Descri\u00e7\u00e3o do problema",
      "type": "string"
    },
    "requester_id": {
      "description": "ID do solicitante \u2014 deve referenciar um registro real da entidade User (n\u00e3o usar texto livre)",
      "type": "string"
    },
    "requester_name": {
      "description": "Nome do solicitante (cache)",
      "type": "string"
    },
    "scheduled_date": {
      "description": "Data/hora de agendamento",
      "format": "date-time",
      "type": "string"
    },
    "sector": {
      "description": "Setor de origem",
      "type": "string"
    },
    "sla_deadline": {
      "description": "Prazo limite calculado (open_date + sla_response_hours/sla_resolution_hours do Contract vinculado ao equipamento). Null quando n\u00e3o h\u00e1 contrato/SLA aplic\u00e1vel.",
      "format": "date-time",
      "type": "string"
    },
    "sla_status": {
      "default": "Sem SLA Definido",
      "description": "Status do cumprimento do SLA, calculado comparando a data atual (ou completion_date) com sla_deadline",
      "enum": [
        "Dentro do Prazo",
        "Atrasado",
        "Sem SLA Definido"
      ],
      "type": "string"
    },
    "start_date": {
      "description": "Data/hora do in\u00edcio do atendimento",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "Novo",
      "description": "Status da OS",
      "enum": [
        "Novo",
        "Em Andamento",
        "Aguardando Pe\u00e7a",
        "Aguardando Fornecedor",
        "Pendente",
        "Conclu\u00eddo"
      ],
      "type": "string"
    },
    "supplier_rating": {
      "description": "Nota do fornecedor (1-5)",
      "type": "number"
    },
    "technical_report": {
      "description": "Laudo t\u00e9cnico",
      "type": "string"
    },
    "technician_id": {
      "description": "ID do t\u00e9cnico respons\u00e1vel \u2014 deve referenciar um registro real da entidade TechTeam (n\u00e3o usar c\u00f3digos avulsos como 'tech-001')",
      "type": "string"
    },
    "technician_name": {
      "description": "Nome do t\u00e9cnico respons\u00e1vel (cache)",
      "type": "string"
    },
    "total_cost": {
      "description": "Custo total",
      "type": "number"
    },
    "type": {
      "description": "Tipo de servi\u00e7o",
      "enum": [
        "Preventiva",
        "Corretiva",
        "Calibra\u00e7\u00e3o",
        "Instala\u00e7\u00e3o"
      ],
      "type": "string"
    }
  },
  "required": [
    "type",
    "equipment_id",
    "problem_description"
  ],
  "type": "object"
}