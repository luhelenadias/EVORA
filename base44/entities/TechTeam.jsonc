{
  "name": "TechTeam",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do t\u00e9cnico"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "El\u00e9trica",
        "Mec\u00e2nica",
        "Biom\u00e9dica",
        "TI"
      ],
      "description": "Especialidade"
    },
    "level": {
      "type": "string",
      "enum": [
        "J\u00fanior",
        "Pleno",
        "S\u00eanior"
      ],
      "description": "N\u00edvel"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Em F\u00e9rias",
        "Afastado"
      ],
      "default": "Ativo",
      "description": "Status"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio vinculado"
    }
  },
  "required": [
    "name",
    "specialty"
  ]
}