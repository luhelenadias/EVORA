{
  "name": "Alerta",
  "properties": {
    "adiado_ate": {
      "description": "Enquanto no futuro, o alerta fica oculto",
      "format": "date-time",
      "type": "string"
    },
    "chave_dedupe": {
      "description": "tipo + entidade_id + nivel. Garante um \u00fanico alerta por situa\u00e7\u00e3o/n\u00edvel; s\u00f3 cria outro se o n\u00edvel escalar. Antes de criar, procurar se j\u00e1 existe.",
      "type": "string"
    },
    "destinatario_perfis": {
      "description": "Perfis que devem ver o alerta (roteamento por perfil)",
      "items": {
        "enum": [
          "admin",
          "tecnico",
          "clinico",
          "gestor"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "dias_referencia": {
      "description": "Dias at\u00e9 o prazo (negativo = dias de atraso), calculado na gera\u00e7\u00e3o",
      "type": "number"
    },
    "entidade_codigo": {
      "description": "C\u00f3digo leg\u00edvel do registro de origem (n\u00ba do contrato, c\u00f3digo da OS, c\u00f3digo do equipamento), para exibi\u00e7\u00e3o",
      "type": "string"
    },
    "entidade_id": {
      "description": "ID do registro que originou o alerta. No alerta agrupado 'OS sem t\u00e9cnico' vale o identificador fixo 'os-sem-tecnico'.",
      "type": "string"
    },
    "entidade_tipo": {
      "description": "Entidade que originou o alerta",
      "enum": [
        "Contract",
        "ServiceOrder",
        "Equipment",
        "SparePart"
      ],
      "type": "string"
    },
    "equipment_id": {
      "description": "ID do equipamento relacionado, quando houver",
      "type": "string"
    },
    "mensagem": {
      "description": "Detalhe do alerta (ex.: 'Contrato CTR-2024-002 venceu h\u00e1 100 dias')",
      "type": "string"
    },
    "nivel": {
      "description": "Gravidade, definida pela anteced\u00eancia/atraso conforme as regras em ConfiguracaoInstituicao",
      "enum": [
        "Informativo",
        "Aten\u00e7\u00e3o",
        "Urgente"
      ],
      "type": "string"
    },
    "prazo_referencia": {
      "description": "Data/hora de refer\u00eancia do alerta (vencimento do contrato, data agendada da preventiva, prazo de SLA)",
      "format": "date-time",
      "type": "string"
    },
    "resolucao": {
      "description": "Autom\u00e1tica quando a causa deixou de existir (preventiva conclu\u00edda, contrato renovado, pe\u00e7a reposta)",
      "enum": [
        "Autom\u00e1tica",
        "Manual"
      ],
      "type": "string"
    },
    "resolvido_em": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "Novo",
      "description": "Ciclo de vida do alerta",
      "enum": [
        "Novo",
        "Visto",
        "Adiado",
        "Resolvido"
      ],
      "type": "string"
    },
    "tecnico_id": {
      "description": "Usu\u00e1rio da equipe t\u00e9cnica respons\u00e1vel, quando o alerta \u00e9 pessoal (ex.: preventiva atribu\u00edda a ele)",
      "type": "string"
    },
    "tipo": {
      "description": "Tipo do alerta. Nomes alinhados com ConfiguracaoInstituicao.alertas_ativos.",
      "enum": [
        "Contrato vencendo",
        "Contrato vencido",
        "Preventiva pr\u00f3xima",
        "Preventiva atrasada",
        "Preventiva muito atrasada",
        "SLA em risco",
        "SLA estourado",
        "Estoque baixo",
        "OS sem t\u00e9cnico",
        "Chamado parado",
        "Garantia vencendo",
        "Calibra\u00e7\u00e3o vencida"
      ],
      "type": "string"
    },
    "titulo": {
      "description": "Texto curto exibido no sino e na lista",
      "type": "string"
    },
    "visto_em": {
      "format": "date-time",
      "type": "string"
    },
    "visto_por": {
      "description": "Usu\u00e1rio que marcou como visto",
      "type": "string"
    }
  },
  "required": [
    "tipo",
    "nivel",
    "titulo",
    "status"
  ],
  "type": "object"
}