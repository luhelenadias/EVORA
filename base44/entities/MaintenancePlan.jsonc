{
  "name": "MaintenancePlan",
  "properties": {
    "ai_suggestion": {
      "description": "Sugest\u00e3o da IA",
      "type": "string"
    },
    "ai_suggestion_date": {
      "description": "Data da \u00faltima sugest\u00e3o de IA",
      "format": "date-time",
      "type": "string"
    },
    "contract_id": {
      "description": "ID do contrato de manuten\u00e7\u00e3o vinculado (quando a preventiva \u00e9 executada por fornecedor externo). Se preenchido, 'frequency' deve ser mantido sincronizado com Contract.preventive_frequency \u2014 divergir os dois indica inconsist\u00eancia a ser revisada.",
      "type": "string"
    },
    "corrective_count_12m": {
      "default": 0,
      "description": "N\u00famero de corretivas nos \u00faltimos 12 meses",
      "type": "number"
    },
    "equipment_id": {
      "description": "ID do equipamento",
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome do equipamento (cache)",
      "type": "string"
    },
    "frequency": {
      "description": "Periodicidade",
      "enum": [
        "Mensal",
        "Trimestral",
        "Semestral",
        "Anual"
      ],
      "type": "string"
    },
    "is_overdue": {
      "default": false,
      "description": "Verdadeiro quando next_execution_date j\u00e1 passou e n\u00e3o h\u00e1 last_execution_date mais recente que ela. Usar para alertas de dashboard.",
      "type": "boolean"
    },
    "last_execution_date": {
      "description": "Data da \u00faltima execu\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "mtbf_hours": {
      "description": "Tempo m\u00e9dio entre falhas (horas)",
      "type": "number"
    },
    "mttr_hours": {
      "description": "Tempo m\u00e9dio de reparo (horas)",
      "type": "number"
    },
    "next_execution_date": {
      "description": "Data prevista da pr\u00f3xima execu\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "Ativo",
      "description": "Status do plano",
      "enum": [
        "Ativo",
        "Suspenso",
        "Conclu\u00eddo"
      ],
      "type": "string"
    }
  },
  "required": [
    "equipment_id",
    "frequency"
  ],
  "type": "object"
}