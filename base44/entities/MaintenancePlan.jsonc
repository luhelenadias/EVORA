{
  "name": "MaintenancePlan",
  "properties": {
    "ai_suggestion": {
      "description": "Sugest\u00e3o da IA",
      "type": "string"
    },
    "ai_suggestion_date": {
      "description": "Data da \u00faltima sugest\u00e3o de IA",
      "format": "date-time",
      "type": "string"
    },
    "contract_id": {
      "description": "ID do contrato de manuten\u00e7\u00e3o vinculado (quando a preventiva \u00e9 executada por fornecedor externo).",
      "type": "string"
    },
    "corrective_count_12m": {
      "default": 0,
      "description": "N\u00famero de corretivas nos \u00faltimos 12 meses",
      "type": "number"
    },
    "equipment_id": {
      "description": "ID do equipamento",
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome do equipamento (cache)",
      "type": "string"
    },
    "frequency": {
      "description": "[LEGADO] Periodicidade em categorias. A fonte de verdade agora \u00e9 Equipment.periodicidade_preventiva_dias (em dias). N\u00e3o usar para novos c\u00e1lculos de gera\u00e7\u00e3o de preventiva.",
      "enum": [
        "Mensal",
        "Trimestral",
        "Semestral",
        "Anual"
      ],
      "type": "string"
    },
    "is_overdue": {
      "default": false,
      "description": "Verdadeiro quando next_execution_date j\u00e1 passou e n\u00e3o h\u00e1 last_execution_date mais recente que ela. Usar para alertas de dashboard.",
      "type": "boolean"
    },
    "last_execution_date": {
      "description": "[LEGADO] A fonte de verdade agora \u00e9 Equipment.data_ultima_preventiva.",
      "format": "date",
      "type": "string"
    },
    "mtbf_hours": {
      "description": "Tempo m\u00e9dio entre falhas (horas). Deve ser recalculado automaticamente a partir do intervalo entre conclus\u00f5es de ServiceOrder tipo Corretiva do mesmo equipamento (Parte C.8), n\u00e3o preenchido manualmente.",
      "type": "number"
    },
    "mttr_hours": {
      "description": "Tempo m\u00e9dio de reparo (horas). Deve ser recalculado automaticamente a partir de duracao_total_minutos das ServiceOrder tipo Corretiva conclu\u00eddas do mesmo equipamento (Parte C.8), n\u00e3o preenchido manualmente.",
      "type": "number"
    },
    "next_execution_date": {
      "description": "[LEGADO] A fonte de verdade agora \u00e9 Equipment.data_proxima_preventiva.",
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "Ativo",
      "description": "Status do plano",
      "enum": [
        "Ativo",
        "Suspenso",
        "Conclu\u00eddo"
      ],
      "type": "string"
    }
  },
  "required": [
    "equipment_id",
    "frequency"
  ],
  "type": "object"
}