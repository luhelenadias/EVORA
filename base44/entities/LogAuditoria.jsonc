{
  "name": "LogAuditoria",
  "type": "object",
  "properties": {
    "acao": {
      "type": "string",
      "description": "A\u00e7\u00e3o registrada",
      "enum": [
        "Abertura",
        "Atribui\u00e7\u00e3o",
        "Reatribui\u00e7\u00e3o",
        "In\u00edcio do atendimento",
        "Mudan\u00e7a de status",
        "Mudan\u00e7a de prioridade",
        "Defini\u00e7\u00e3o de rota",
        "Altera\u00e7\u00e3o de rota",
        "Triagem",
        "Devolu\u00e7\u00e3o ao solicitante",
        "Pausa",
        "Retomada",
        "Pedido de pe\u00e7a",
        "Atualiza\u00e7\u00e3o de pedido de pe\u00e7a",
        "Edi\u00e7\u00e3o de campo",
        "Pe\u00e7a utilizada",
        "Rascunho de relat\u00f3rio gerado por IA",
        "Relat\u00f3rio confirmado",
        "Fechamento",
        "Reabertura",
        "Cancelamento",
        "Upload de documento",
        "Extra\u00e7\u00e3o por IA",
        "Notifica\u00e7\u00e3o ao t\u00e9cnico",
        "Mudan\u00e7a de perfil",
        "Ajuste administrativo",
        "Exclus\u00e3o de conta"
      ]
    },
    "anterior_a_auditoria": {
      "type": "boolean",
      "default": false,
      "description": "Marca registros que existiam antes do log; nunca inventar hist\u00f3rico retroativo."
    },
    "campo": {
      "type": "string",
      "description": "Campo alterado, quando a\u00e7\u00e3o for edi\u00e7\u00e3o/mudan\u00e7a"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da a\u00e7\u00e3o, marcado pelo SERVIDOR (n\u00e3o pelo navegador)"
    },
    "entidade_codigo": {
      "type": "string",
      "description": "C\u00f3digo leg\u00edvel (c\u00f3digo da OS, n\u00ba do contrato, c\u00f3digo do equipamento, e-mail do usu\u00e1rio)"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "entidade_tipo": {
      "type": "string",
      "description": "Entidade afetada. 'LogAuditoria' identifica a\u00e7\u00f5es sobre o pr\u00f3prio log (exporta\u00e7\u00e3o em CSV).",
      "enum": [
        "ServiceOrder",
        "Contract",
        "Equipment",
        "SparePart",
        "MaintenancePlan",
        "Acquisition",
        "ConfiguracaoInstituicao",
        "User",
        "LogAuditoria"
      ]
    },
    "motivo": {
      "type": "string",
      "description": "Justificativa, quando exigida (ex.: motivo de sobrescrita de prioridade, de troca da rota de atendimento, de pausa ou de reabertura da triagem)"
    },
    "origem": {
      "type": "string",
      "default": "Usu\u00e1rio",
      "description": "Usu\u00e1rio = pessoa; IA = rascunho/extra\u00e7\u00e3o autom\u00e1tica; Sistema = automa\u00e7\u00e3o (gerador de preventivas, resolu\u00e7\u00e3o de alertas); Ajuste administrativo = altera\u00e7\u00e3o direta no banco",
      "enum": [
        "Usu\u00e1rio",
        "IA",
        "Sistema",
        "Ajuste administrativo"
      ]
    },
    "tecnico_atribuido_id": {
      "type": "string",
      "description": "Usu\u00e1rio da equipe t\u00e9cnica atribu\u00eddo \u00e0 OS no momento (pode diferir de quem executou a a\u00e7\u00e3o)"
    },
    "usuario_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio (cache)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que executou a a\u00e7\u00e3o (null quando origem = Sistema)"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio (cache)"
    },
    "usuario_perfil": {
      "type": "string",
      "description": "Perfil do usu\u00e1rio no momento da a\u00e7\u00e3o",
      "enum": [
        "admin",
        "tecnico",
        "clinico",
        "gestor"
      ]
    },
    "valor_anterior": {
      "type": "string",
      "description": "Valor antes da altera\u00e7\u00e3o (texto)"
    },
    "valor_novo": {
      "type": "string",
      "description": "Valor depois da altera\u00e7\u00e3o (texto)"
    }
  },
  "required": [
    "entidade_tipo",
    "entidade_id",
    "acao",
    "origem",
    "data_hora"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "nobody"
      }
    },
    "delete": {
      "user_condition": {
        "role": "nobody"
      }
    }
  }
}