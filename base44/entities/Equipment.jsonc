{
  "name": "Equipment",
  "properties": {
    "acquisition_date": {
      "description": "Data de aquisi\u00e7\u00e3o. Usada tamb\u00e9m como origem do bloco 4 (ano) do codigo_equipamento.",
      "format": "date",
      "type": "string"
    },
    "acquisition_value": {
      "description": "Valor de aquisi\u00e7\u00e3o (R$)",
      "type": "number"
    },
    "anvisa_registry": {
      "description": "Registro ANVISA",
      "type": "string"
    },
    "attachments": {
      "description": "Anexos (manuais, certificados, fotos)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "codigo_equipamento": {
      "description": "C\u00f3digo t\u00e9cnico gerado automaticamente (padr\u00e3o Calil): {sigla_setor}-{sigla_tipo}{sequencial}{ano_aquisicao_2digitos}, ex: CC-VT0394. Somente leitura \u2014 n\u00e3o editar diretamente. \u00danico por institui\u00e7\u00e3o.",
      "type": "string"
    },
    "contract_id": {
      "description": "ID do contrato vinculado",
      "type": "string"
    },
    "criticality": {
      "description": "N\u00edvel de criticidade",
      "enum": [
        "Suporte \u00e0 Vida",
        "Terap\u00eautico",
        "Diagn\u00f3stico",
        "Apoio"
      ],
      "type": "string"
    },
    "data_proxima_preventiva": {
      "description": "Calculado: data_ultima_preventiva + periodicidade_preventiva_dias. Fonte de verdade para a gera\u00e7\u00e3o autom\u00e1tica de manuten\u00e7\u00e3o preventiva (ServiceOrder tipo Preventiva). Tamb\u00e9m usado como scheduled_date da OS gerada, para alimentar o Calend\u00e1rio de Preventivas.",
      "format": "date",
      "type": "string"
    },
    "data_ultima_preventiva": {
      "description": "Atualizado automaticamente ao concluir uma ServiceOrder do tipo Preventiva para este equipamento.",
      "format": "date",
      "type": "string"
    },
    "funcao_f": {
      "description": "Modelo Simples (Fennigkoh & Smith) \u2014 Fun\u00e7\u00e3o (F), de 2 a 10 conforme a tabela do m\u00e9todo (suporte \u00e0 vida = 10 ... relacionado ao paciente e outros = 2). Sempre obrigat\u00f3rio, independente do modelo de prioriza\u00e7\u00e3o ativo.",
      "maximum": 10,
      "minimum": 2,
      "type": "number"
    },
    "image_url": {
      "description": "Foto do equipamento",
      "type": "string"
    },
    "installation_date": {
      "description": "Data de instala\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "last_calibration_date": {
      "description": "Data da \u00faltima calibra\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "location_sector": {
      "description": "Setor de localiza\u00e7\u00e3o (texto livre, descritivo \u2014 diferente de setor_id, que \u00e9 o setor codificado usado no c\u00f3digo t\u00e9cnico)",
      "type": "string"
    },
    "location_unit": {
      "description": "Unidade de localiza\u00e7\u00e3o",
      "type": "string"
    },
    "manufacturer": {
      "description": "Fabricante",
      "type": "string"
    },
    "manutencao_m": {
      "description": "Modelo Avan\u00e7ado \u2014 Manuten\u00e7\u00e3o (M), mesma tabela e escala do requisitos_manutencao_mr (1 a 5). Obrigat\u00f3rio apenas no modelo avan\u00e7ado.",
      "maximum": 5,
      "minimum": 1,
      "type": "number"
    },
    "mission_critical_mc": {
      "description": "Modelo Avan\u00e7ado \u2014 Mission Critical (MC), escala 1 a 10, definida pela institui\u00e7\u00e3o conforme a criticidade do equipamento para a miss\u00e3o global. Obrigat\u00f3rio apenas se ConfiguracaoInstituicao.modelo_priorizacao = 'avancado'.",
      "maximum": 10,
      "minimum": 1,
      "type": "number"
    },
    "model": {
      "description": "Modelo",
      "type": "string"
    },
    "name": {
      "description": "Nome do equipamento",
      "type": "string"
    },
    "next_calibration_date": {
      "description": "Data da pr\u00f3xima calibra\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "operational_status": {
      "default": "Ativo",
      "description": "Status operacional",
      "enum": [
        "Ativo",
        "Em Manuten\u00e7\u00e3o",
        "Parado",
        "Inativo/Baixado"
      ],
      "type": "string"
    },
    "patrimony_number": {
      "description": "N\u00famero de patrim\u00f4nio \u2014 uso cont\u00e1bil/invent\u00e1rio, texto livre, editado manualmente. Sem rela\u00e7\u00e3o com codigo_equipamento (o c\u00f3digo t\u00e9cnico gerado automaticamente).",
      "type": "string"
    },
    "periodicidade_preventiva_dias": {
      "description": "Periodicidade da manuten\u00e7\u00e3o preventiva em dias (ex: 90 = trimestral), idealmente vinda do manual do fabricante. Fonte de verdade da periodicidade \u2014 substitui MaintenancePlan.frequency, que fica como campo legado.",
      "type": "number"
    },
    "prioridade_alta": {
      "default": false,
      "description": "Simples: verdadeiro se EM >= 12 (crit\u00e9rio de inclus\u00e3o de Fennigkoh & Smith). Avan\u00e7ado (EMR/AEMR): verdadeiro se prioridade_faixa for 'Cr\u00edtica' ou 'Alta'. Calculado pelo sistema.",
      "type": "boolean"
    },
    "prioridade_faixa": {
      "description": "Faixa relativa de prioridade do equipamento dentro do parque, por quartis (cortes configur\u00e1veis em ConfiguracaoInstituicao). Nulo enquanto status_priorizacao = 'pendente_atualizacao'. Calculado pelo sistema.",
      "enum": [
        "Cr\u00edtica",
        "Alta",
        "M\u00e9dia",
        "Baixa"
      ],
      "type": "string"
    },
    "prioridade_modelo": {
      "description": "F\u00f3rmula que gerou prioridade_score: EM (simples), EMR (avan\u00e7ado sem utiliza\u00e7\u00e3o) ou AEMR (avan\u00e7ado com utiliza\u00e7\u00e3o). Calculado pelo sistema; scores de modelos diferentes nunca s\u00e3o comparados entre si.",
      "enum": [
        "EM",
        "EMR",
        "AEMR"
      ],
      "type": "string"
    },
    "prioridade_posicao": {
      "description": "Posi\u00e7\u00e3o no ranking de prioridade (1 = mais priorit\u00e1rio), entre os equipamentos com status_priorizacao = 'calculado' e n\u00e3o baixados. Desempate: maior prioridade_score, depois criticidade (Suporte \u00e0 Vida > Terap\u00eautico > Diagn\u00f3stico > Apoio), depois mais corretivas nos \u00faltimos 12 meses, depois codigo_equipamento. Calculado pelo sistema.",
      "type": "number"
    },
    "prioridade_score": {
      "description": "Resultado do c\u00e1lculo de prioriza\u00e7\u00e3o (EM no modelo simples; EMR ou AEMR no avan\u00e7ado \u2014 ver prioridade_modelo). Calculado pelo sistema ao salvar/editar o equipamento.",
      "type": "number"
    },
    "requisitos_manutencao_mr": {
      "description": "Modelo Simples (Fennigkoh & Smith) \u2014 Requisitos de Manuten\u00e7\u00e3o (MR), de 1 (m\u00ednima) a 5 (extensiva). Sempre obrigat\u00f3rio.",
      "maximum": 5,
      "minimum": 1,
      "type": "number"
    },
    "risco_fisico_pr": {
      "description": "Modelo Simples (Fennigkoh & Smith) \u2014 Risco F\u00edsico (PR), de 1 (sem risco significativo) a 5 (morte do paciente). Sempre obrigat\u00f3rio.",
      "maximum": 5,
      "minimum": 1,
      "type": "number"
    },
    "risco_r": {
      "description": "Modelo Avan\u00e7ado \u2014 Risco (R), crit\u00e9rio ECRI: Baixo=1, M\u00e9dio=3, Alto=5. Obrigat\u00f3rio apenas no modelo avan\u00e7ado.",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto"
      ],
      "type": "string"
    },
    "sequencial_unidade": {
      "description": "Sequencial de 2 d\u00edgitos (bloco 3 do codigo_equipamento), calculado automaticamente contando os equipamentos j\u00e1 cadastrados com o mesmo setor_id + tipo_equipamento_id",
      "type": "number"
    },
    "serial_number": {
      "description": "N\u00famero de s\u00e9rie",
      "type": "string"
    },
    "setor_id": {
      "description": "Refer\u00eancia \u00e0 entidade CodigoSetor. Obrigat\u00f3rio \u2014 usado no bloco 1 do codigo_equipamento.",
      "type": "string"
    },
    "status_priorizacao": {
      "default": "pendente_atualizacao",
      "description": "Calculado pelo sistema, n\u00e3o edit\u00e1vel pelo usu\u00e1rio. 'pendente_atualizacao' quando faltam campos obrigat\u00f3rios do modelo ativo.",
      "enum": [
        "calculado",
        "pendente_atualizacao"
      ],
      "type": "string"
    },
    "tecnico_padrao_id": {
      "description": "Refer\u00eancia opcional a um usu\u00e1rio (entidade User) com perfil t\u00e9cnico \u2014 \u00e9 o ID da pessoa da equipe t\u00e9cnica respons\u00e1vel pelas preventivas deste equipamento. Usado para atribuir automaticamente technician_id ao gerar a ServiceOrder preventiva. Se vazio, a preventiva \u00e9 gerada sem t\u00e9cnico e aparece como 'N\u00e3o atribu\u00edda' no Calend\u00e1rio de Preventivas, para o administrador designar manualmente.",
      "type": "string"
    },
    "tipo_equipamento_id": {
      "description": "Refer\u00eancia \u00e0 entidade CodigoTipoEquipamento. Obrigat\u00f3rio \u2014 usado no bloco 2 do codigo_equipamento.",
      "type": "string"
    },
    "total_operators": {
      "description": "N\u00famero de operadores que utilizam o equipamento",
      "type": "number"
    },
    "trained_operators": {
      "description": "N\u00famero de operadores treinados",
      "type": "number"
    },
    "utilizacao_u": {
      "description": "Modelo Avan\u00e7ado \u2014 Utiliza\u00e7\u00e3o (U), fra\u00e7\u00e3o do tempo em que o equipamento \u00e9 usado, de 0.0 a 1.0. Obrigat\u00f3rio apenas se avancado_usa_utilizacao = true.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "warranty_end": {
      "description": "Fim da garantia",
      "format": "date",
      "type": "string"
    },
    "weekly_usage_hours": {
      "description": "Horas m\u00e9dias de uso por semana",
      "type": "number"
    }
  },
  "required": [
    "name",
    "serial_number",
    "criticality"
  ],
  "type": "object"
}