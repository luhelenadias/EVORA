{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do equipamento"
    },
    "manufacturer": {
      "type": "string",
      "description": "Fabricante"
    },
    "model": {
      "type": "string",
      "description": "Modelo"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "anvisa_registry": {
      "type": "string",
      "description": "Registro ANVISA"
    },
    "patrimony_number": {
      "type": "string",
      "description": "N\u00famero de patrim\u00f4nio"
    },
    "location_unit": {
      "type": "string",
      "description": "Unidade de localiza\u00e7\u00e3o"
    },
    "location_sector": {
      "type": "string",
      "description": "Setor de localiza\u00e7\u00e3o"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date",
      "description": "Data de aquisi\u00e7\u00e3o"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "description": "Data de instala\u00e7\u00e3o"
    },
    "acquisition_value": {
      "type": "number",
      "description": "Valor de aquisi\u00e7\u00e3o (R$)"
    },
    "warranty_end": {
      "type": "string",
      "format": "date",
      "description": "Fim da garantia"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "Suporte \u00e0 Vida",
        "Terap\u00eautico",
        "Diagn\u00f3stico",
        "Apoio"
      ],
      "description": "N\u00edvel de criticidade"
    },
    "operational_status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Em Manuten\u00e7\u00e3o",
        "Parado",
        "Inativo/Baixado"
      ],
      "default": "Ativo",
      "description": "Status operacional"
    },
    "contract_id": {
      "type": "string",
      "description": "ID do contrato vinculado"
    },
    "attachments": {
      "type": "array",
      "description": "Anexos (manuais, certificados, fotos)",
      "items": {
        "type": "string"
      }
    },
    "last_calibration_date": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima calibra\u00e7\u00e3o"
    },
    "next_calibration_date": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima calibra\u00e7\u00e3o"
    },
    "image_url": {
      "type": "string",
      "description": "Foto do equipamento"
    },
    "weekly_usage_hours": {
      "type": "number",
      "description": "Horas m\u00e9dias de uso por semana"
    },
    "total_operators": {
      "type": "number",
      "description": "N\u00famero de operadores que utilizam o equipamento"
    },
    "trained_operators": {
      "type": "number",
      "description": "N\u00famero de operadores treinados"
    }
  },
  "required": [
    "name",
    "serial_number",
    "criticality"
  ]
}