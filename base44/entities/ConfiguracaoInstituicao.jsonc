{
  "name": "ConfiguracaoInstituicao",
  "properties": {
    "acessos_perfil": {
      "description": "Abas da barra lateral liberadas em cada perfil de usu\u00e1rio. Cada item guarda o perfil e a lista de chaves de aba permitidas (ver src/lib/roles.js). Quando um perfil n\u00e3o aparece na lista, o sistema aplica as pr\u00e9-defini\u00e7\u00f5es padr\u00e3o. Edit\u00e1vel em Configura\u00e7\u00f5es \u2192 Acessos por Perfil.",
      "items": {
        "properties": {
          "abas": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "perfil": {
            "enum": [
              "admin",
              "tecnico",
              "clinico",
              "gestor"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "alerta_chamado_parado_dias": {
      "default": 5,
      "description": "Dias que uma OS pode ficar em Aguardando Pe\u00e7a/Fornecedor/Pendente antes de gerar 'Chamado parado'",
      "type": "number"
    },
    "alerta_contrato_dias": {
      "default": [
        90,
        60,
        30
      ],
      "description": "Anteced\u00eancia (em dias) dos avisos de contrato vencendo, do mais distante ao mais pr\u00f3ximo. Padr\u00e3o [90, 60, 30]. Cada valor gera um alerta pr\u00f3prio, uma vez. Ap\u00f3s o fim da vig\u00eancia, gera 'Contrato vencido'.",
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "alerta_preventiva_antecedencia_dias": {
      "default": 7,
      "description": "Dias antes da data agendada em que a preventiva gera o alerta 'Preventiva pr\u00f3xima'",
      "type": "number"
    },
    "alerta_preventiva_muito_atrasada_dias": {
      "default": 30,
      "description": "Dias de atraso a partir dos quais a preventiva gera 'Preventiva muito atrasada' (escala para gestor)",
      "type": "number"
    },
    "alerta_sla_risco_pct": {
      "default": 80,
      "description": "Percentual do prazo de SLA consumido a partir do qual gera 'SLA em risco'",
      "type": "number"
    },
    "alertas_ativos": {
      "default": [
        "Contrato vencendo",
        "Contrato vencido",
        "Preventiva pr\u00f3xima",
        "Preventiva atrasada",
        "Preventiva muito atrasada",
        "SLA em risco",
        "SLA estourado",
        "Estoque baixo",
        "OS sem t\u00e9cnico",
        "Chamado parado"
      ],
      "description": "Tipos de alerta ligados na institui\u00e7\u00e3o. Garantia e calibra\u00e7\u00e3o come\u00e7am desligados at\u00e9 os campos serem preenchidos.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "avancado_usa_utilizacao": {
      "default": false,
      "description": "Se verdadeiro, o modelo avan\u00e7ado usa a f\u00f3rmula com utiliza\u00e7\u00e3o (AEMR) e passa a exigir o campo utilizacao_u. Se falso, usa a f\u00f3rmula sem utiliza\u00e7\u00e3o (EMR).",
      "type": "boolean"
    },
    "custo_hora_tecnica": {
      "description": "Custo m\u00e9dio da hora t\u00e9cnica em R$. Usado em Indicadores \u2192 Equipe para estimar o custo da m\u00e3o de obra interna (horas registradas em OS \u00d7 custo da hora). Sem esse valor, o indicador mostra aviso em vez de estimar.",
      "type": "number"
    },
    "email_modo_teste": {
      "default": true,
      "description": "Modo teste de e-mail. Enquanto ligado, TODO e-mail para t\u00e9cnico \u00e9 redirecionado para email_teste_destino, com o destinat\u00e1rio real indicado no assunto e no corpo. Exibido em Configura\u00e7\u00f5es \u2192 Notifica\u00e7\u00f5es. Desligue apenas quando os e-mails dos t\u00e9cnicos forem reais e verificados.",
      "type": "boolean"
    },
    "email_teste_destino": {
      "default": "lhdias@unifesp.br",
      "description": "Endere\u00e7o que recebe todos os e-mails enquanto o modo teste estiver ligado.",
      "type": "string"
    },
    "faixa_alta_ate_pct": {
      "default": 50,
      "description": "Corte acumulado da faixa 'Alta': equipamentos entre faixa_critica_ate_pct e este valor (% do parque, do mais priorit\u00e1rio para o menos) ficam em 'Alta'. Padr\u00e3o 50 (quartis).",
      "maximum": 98,
      "minimum": 2,
      "type": "number"
    },
    "faixa_critica_ate_pct": {
      "default": 25,
      "description": "Corte acumulado da faixa 'Cr\u00edtica': os primeiros X% do ranking de prioridade (do mais priorit\u00e1rio para o menos) ficam em 'Cr\u00edtica'. Padr\u00e3o 25 (quartis).",
      "maximum": 97,
      "minimum": 1,
      "type": "number"
    },
    "faixa_media_ate_pct": {
      "default": 75,
      "description": "Corte acumulado da faixa 'M\u00e9dia': equipamentos entre faixa_alta_ate_pct e este valor ficam em 'M\u00e9dia'; o restante fica em 'Baixa'. Padr\u00e3o 75 (quartis). Deve valer faixa_critica_ate_pct < faixa_alta_ate_pct < faixa_media_ate_pct < 100.",
      "maximum": 99,
      "minimum": 3,
      "type": "number"
    },
    "modelo_priorizacao": {
      "default": "simples",
      "description": "Modelo de prioriza\u00e7\u00e3o de manuten\u00e7\u00e3o adotado pela institui\u00e7\u00e3o",
      "enum": [
        "simples",
        "avancado"
      ],
      "type": "string"
    },
    "rechamada_dias": {
      "default": 30,
      "description": "Janela em dias para considerar rechamada: uma nova corretiva no mesmo equipamento aberta at\u00e9 X dias depois de uma corretiva conclu\u00edda. Padr\u00e3o 30. Usado em Indicadores \u2192 Confiabilidade.",
      "type": "number"
    }
  },
  "required": [],
  "type": "object"
}