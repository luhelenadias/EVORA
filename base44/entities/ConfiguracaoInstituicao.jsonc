{
  "name": "ConfiguracaoInstituicao",
  "properties": {
    "acessos_perfil": {
      "description": "Abas da barra lateral liberadas em cada perfil de usu\u00e1rio. Cada item guarda o perfil e a lista de chaves de aba permitidas (ver src/lib/roles.js). Quando um perfil n\u00e3o aparece na lista, o sistema aplica as pr\u00e9-defini\u00e7\u00f5es padr\u00e3o. Edit\u00e1vel em Configura\u00e7\u00f5es \u2192 Acessos por Perfil.",
      "items": {
        "properties": {
          "abas": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "perfil": {
            "enum": [
              "admin",
              "tecnico",
              "clinico",
              "gestor"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "alerta_contrato_dias": {
      "default": [
        90,
        60,
        30
      ],
      "description": "Anteced\u00eancia (dias antes do fim da vig\u00eancia) em que o alerta de contrato vencendo \u00e9 gerado, do maior para o menor. Padr\u00e3o [90, 60, 30]. O n\u00edvel sobe a cada marco: 90=Informativo, 60=Aten\u00e7\u00e3o, 30=Urgente.",
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "alerta_os_parada_dias": {
      "default": 5,
      "description": "Dias sem andamento em 'Aguardando Pe\u00e7a/Fornecedor' ou 'Novo' sem t\u00e9cnico para gerar 'OS parada' / 'OS sem t\u00e9cnico'.",
      "type": "number"
    },
    "alerta_preventiva_antecedencia_dias": {
      "default": 7,
      "description": "Dias antes da data agendada em que a preventiva gera alerta 'Preventiva pr\u00f3xima' (Informativo).",
      "type": "number"
    },
    "alerta_preventiva_atraso_atencao_dias": {
      "default": 1,
      "description": "A partir de quantos dias de atraso a preventiva gera 'Preventiva atrasada' n\u00edvel Aten\u00e7\u00e3o (para o t\u00e9cnico respons\u00e1vel).",
      "type": "number"
    },
    "alerta_preventiva_atraso_urgente_dias": {
      "default": 30,
      "description": "A partir de quantos dias de atraso a preventiva escala para n\u00edvel Urgente (tamb\u00e9m para o gestor).",
      "type": "number"
    },
    "alerta_tipos_ativos": {
      "description": "Tipos de alerta ligados na institui\u00e7\u00e3o. Vazio = todos os tipos, exceto Garantia vencendo e Calibra\u00e7\u00e3o vencida (campos ainda pouco preenchidos).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "avancado_usa_utilizacao": {
      "default": false,
      "description": "Se verdadeiro, o modelo avan\u00e7ado usa a f\u00f3rmula com utiliza\u00e7\u00e3o (AEMR) e passa a exigir o campo utilizacao_u. Se falso, usa a f\u00f3rmula sem utiliza\u00e7\u00e3o (EMR).",
      "type": "boolean"
    },
    "faixa_alta_ate_pct": {
      "default": 50,
      "description": "Corte acumulado da faixa 'Alta': equipamentos entre faixa_critica_ate_pct e este valor (% do parque, do mais priorit\u00e1rio para o menos) ficam em 'Alta'. Padr\u00e3o 50 (quartis).",
      "maximum": 98,
      "minimum": 2,
      "type": "number"
    },
    "faixa_critica_ate_pct": {
      "default": 25,
      "description": "Corte acumulado da faixa 'Cr\u00edtica': os primeiros X% do ranking de prioridade (do mais priorit\u00e1rio para o menos) ficam em 'Cr\u00edtica'. Padr\u00e3o 25 (quartis).",
      "maximum": 97,
      "minimum": 1,
      "type": "number"
    },
    "faixa_media_ate_pct": {
      "default": 75,
      "description": "Corte acumulado da faixa 'M\u00e9dia': equipamentos entre faixa_alta_ate_pct e este valor ficam em 'M\u00e9dia'; o restante fica em 'Baixa'. Padr\u00e3o 75 (quartis). Deve valer faixa_critica_ate_pct < faixa_alta_ate_pct < faixa_media_ate_pct < 100.",
      "maximum": 99,
      "minimum": 3,
      "type": "number"
    },
    "modelo_priorizacao": {
      "default": "simples",
      "description": "Modelo de prioriza\u00e7\u00e3o de manuten\u00e7\u00e3o adotado pela institui\u00e7\u00e3o",
      "enum": [
        "simples",
        "avancado"
      ],
      "type": "string"
    }
  },
  "required": [],
  "type": "object"
}