{
  "name": "PedidoPeca",
  "properties": {
    "chegou_em": {
      "format": "date-time",
      "type": "string"
    },
    "descricao_livre": {
      "description": "Descri\u00e7\u00e3o da pe\u00e7a quando n\u00e3o vem do cat\u00e1logo. Obrigat\u00f3ria quando spare_part_id est\u00e1 vazio \u2014 pe\u00e7a fora do cat\u00e1logo \u00e9 permitida e \u00e9 o caso comum.",
      "type": "string"
    },
    "em_compra_em": {
      "format": "date-time",
      "type": "string"
    },
    "em_estoque_no_pedido": {
      "default": false,
      "description": "Verdadeiro quando, no momento do pedido, a pe\u00e7a do cat\u00e1logo tinha estoque suficiente. Nesse caso o almoxarifado separa a pe\u00e7a e n\u00e3o h\u00e1 sugest\u00e3o de pausa.",
      "type": "boolean"
    },
    "equipment_id": {
      "description": "Equipamento da OS.",
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome do equipamento (cache).",
      "type": "string"
    },
    "observacao": {
      "description": "Observa\u00e7\u00e3o livre de quem pediu ou de quem movimentou o pedido.",
      "type": "string"
    },
    "os_codigo": {
      "description": "C\u00f3digo da OS (cache, ex.: OS-2026-031).",
      "type": "string"
    },
    "pausa_id": {
      "description": "ID da pausa criada por este pedido, quando a manuten\u00e7\u00e3o foi pausada aguardando a pe\u00e7a.",
      "type": "string"
    },
    "previsao_chegada": {
      "description": "Previs\u00e3o de chegada informada ao mover para Em compra (opcional).",
      "format": "date",
      "type": "string"
    },
    "quantidade": {
      "default": 1,
      "description": "Quantidade pedida.",
      "type": "number"
    },
    "retirada_em": {
      "format": "date-time",
      "type": "string"
    },
    "service_order_id": {
      "description": "OS que originou o pedido (obrigat\u00f3rio).",
      "type": "string"
    },
    "solicitado_em": {
      "description": "Data/hora do pedido, marcada pelo servidor.",
      "format": "date-time",
      "type": "string"
    },
    "solicitante_id": {
      "description": "Usu\u00e1rio que pediu a pe\u00e7a (referencia User).",
      "type": "string"
    },
    "solicitante_nome": {
      "description": "Nome de quem pediu (cache).",
      "type": "string"
    },
    "spare_part_id": {
      "description": "Pe\u00e7a do cat\u00e1logo SparePart. Vazio quando a pe\u00e7a \u00e9 fora do cat\u00e1logo (descri\u00e7\u00e3o livre).",
      "type": "string"
    },
    "status": {
      "default": "Solicitada",
      "description": "Andamento do pedido. Em compra/Chegou/Cancelada s\u00e3o movidos por admin e gestor; Retirada \u00e9 marcada pelo t\u00e9cnico respons\u00e1vel da OS.",
      "enum": [
        "Solicitada",
        "Em compra",
        "Chegou",
        "Retirada",
        "Cancelada"
      ],
      "type": "string"
    },
    "tecnico_responsavel_id": {
      "description": "T\u00e9cnico respons\u00e1vel pela OS no momento do pedido. Usado para que o t\u00e9cnico veja apenas os pedidos das suas OS.",
      "type": "string"
    },
    "urgencia": {
      "default": "M\u00e9dia",
      "description": "Urg\u00eancia do pedido, definida por quem pede.",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ],
      "type": "string"
    }
  },
  "required": [
    "service_order_id",
    "quantidade",
    "urgencia",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "data.tecnico_responsavel_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "data.tecnico_responsavel_id": "{{user.id}}"
        }
      ]
    }
  },
  "type": "object"
}