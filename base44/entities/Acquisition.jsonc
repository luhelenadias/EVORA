{
  "name": "Acquisition",
  "properties": {
    "approval_date": {
      "description": "Data da aprova\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "approved_by_id": {
      "description": "ID de quem aprovou a aquisi\u00e7\u00e3o (referencia User)",
      "type": "string"
    },
    "attachments": {
      "description": "Anexos (propostas, pareceres t\u00e9cnicos, atas de aprova\u00e7\u00e3o)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "code": {
      "description": "C\u00f3digo da solicita\u00e7\u00e3o (gerado automaticamente)",
      "type": "string"
    },
    "cost_benefit_notes": {
      "description": "An\u00e1lise de custo-benef\u00edcio (custo total de propriedade, disponibilidade de pe\u00e7as/assist\u00eancia local, compara\u00e7\u00e3o entre cota\u00e7\u00f5es)",
      "type": "string"
    },
    "criticality": {
      "description": "Criticidade prevista do equipamento a ser adquirido",
      "enum": [
        "Suporte \u00e0 Vida",
        "Terap\u00eautico",
        "Diagn\u00f3stico",
        "Apoio"
      ],
      "type": "string"
    },
    "equipment_name": {
      "description": "Nome/descri\u00e7\u00e3o do equipamento pretendido",
      "type": "string"
    },
    "estimated_value": {
      "description": "Valor estimado (R$)",
      "type": "number"
    },
    "expected_delivery_date": {
      "description": "Previs\u00e3o de entrega/instala\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "justification": {
      "description": "Justificativa cl\u00ednica/operacional para a aquisi\u00e7\u00e3o (equipamento novo, substitui\u00e7\u00e3o por obsolesc\u00eancia, expans\u00e3o de capacidade, etc.)",
      "type": "string"
    },
    "quotations": {
      "description": "Cota\u00e7\u00f5es recebidas de fornecedores",
      "items": {
        "properties": {
          "delivery_days": {
            "type": "number"
          },
          "has_local_technical_support": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "warranty_months": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "replacement_equipment_id": {
      "description": "ID do equipamento existente que ser\u00e1 substitu\u00eddo, quando aplic\u00e1vel (referencia Equipment)",
      "type": "string"
    },
    "request_date": {
      "description": "Data da solicita\u00e7\u00e3o",
      "format": "date",
      "type": "string"
    },
    "requested_by_id": {
      "description": "ID do usu\u00e1rio solicitante (referencia User)",
      "type": "string"
    },
    "requested_by_name": {
      "description": "Nome do solicitante (cache)",
      "type": "string"
    },
    "requesting_sector": {
      "description": "Setor solicitante",
      "type": "string"
    },
    "resulting_equipment_id": {
      "description": "ID do registro criado em Equipment ap\u00f3s a instala\u00e7\u00e3o (fecha o ciclo aquisi\u00e7\u00e3o \u2192 ativo em opera\u00e7\u00e3o)",
      "type": "string"
    },
    "status": {
      "default": "Solicitado",
      "description": "Status do processo de aquisi\u00e7\u00e3o",
      "enum": [
        "Solicitado",
        "Em An\u00e1lise T\u00e9cnica",
        "Em Cota\u00e7\u00e3o",
        "Aprovado",
        "Rejeitado",
        "Comprado",
        "Instalado"
      ],
      "type": "string"
    },
    "technical_specification": {
      "description": "Especifica\u00e7\u00e3o t\u00e9cnica m\u00ednima exigida",
      "type": "string"
    }
  },
  "required": [
    "equipment_name",
    "requesting_sector",
    "justification"
  ],
  "type": "object"
}