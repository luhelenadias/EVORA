{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "tecnico",
        "clinico",
        "gestor"
      ],
      "default": "clinico",
      "description": "Tipo de usu\u00e1rio: admin = Administrativo, tecnico = Equipe t\u00e9cnica, clinico = Cl\u00ednica, gestor = Gest\u00e3o"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "department": {
      "type": "string",
      "description": "Setor/Departamento"
    },
    "situacao": {
      "type": "string",
      "enum": [
        "Ativo",
        "Em F\u00e9rias",
        "Afastado",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Situa\u00e7\u00e3o do usu\u00e1rio. 'Inativo' substitui a exclus\u00e3o: o hist\u00f3rico de OS, agenda e auditoria \u00e9 preservado. S\u00f3 a Equipe t\u00e9cnica Ativa pode receber chamados."
    },
    "especialidade": {
      "type": "string",
      "enum": [
        "El\u00e9trica",
        "Mec\u00e2nica",
        "Biom\u00e9dica",
        "TI"
      ],
      "description": "Especialidade \u2014 usada apenas no perfil tecnico (Equipe t\u00e9cnica)"
    },
    "nivel": {
      "type": "string",
      "enum": [
        "J\u00fanior",
        "Pleno",
        "S\u00eanior"
      ],
      "description": "N\u00edvel t\u00e9cnico \u2014 usada apenas no perfil tecnico (Equipe t\u00e9cnica)"
    }
  }
}