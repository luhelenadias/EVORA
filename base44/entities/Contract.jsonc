{
  "name": "Contract",
  "properties": {
    "campos_revisar": {
      "description": "Chaves de campo extra\u00eddos com baixa certeza ou ausentes, marcados como 'revisar' na interface",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cnpj": {
      "description": "CNPJ do fornecedor",
      "type": "string"
    },
    "contract_number": {
      "description": "N\u00famero do contrato",
      "type": "string"
    },
    "covered_equipment_ids": {
      "description": "IDs dos equipamentos cobertos",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "documento_atual_url": {
      "description": "URL (armazenamento PRIVADO) do PDF vigente do contrato. Acesso apenas para admin e gestor.",
      "type": "string"
    },
    "end_date": {
      "description": "Data de fim de vig\u00eancia",
      "format": "date",
      "type": "string"
    },
    "extracao_em": {
      "description": "Data/hora da \u00faltima extra\u00e7\u00e3o por IA",
      "format": "date-time",
      "type": "string"
    },
    "extracao_status": {
      "default": "Sem documento",
      "description": "Estado da extra\u00e7\u00e3o por IA: nada \u00e9 considerado confirmado at\u00e9 o usu\u00e1rio revisar.",
      "enum": [
        "Sem documento",
        "Pendente de revis\u00e3o",
        "Revisado"
      ],
      "type": "string"
    },
    "fontes_extracao": {
      "description": "Origem de cada campo extra\u00eddo, para confer\u00eancia: p\u00e1gina e trecho literal do PDF, mais n\u00edvel de certeza.",
      "items": {
        "properties": {
          "campo": {
            "type": "string"
          },
          "certeza": {
            "enum": [
              "Alta",
              "M\u00e9dia",
              "Baixa"
            ],
            "type": "string"
          },
          "pagina": {
            "type": "number"
          },
          "trecho": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "historico_alteracoes": {
      "description": "Registro de edi\u00e7\u00f5es nos dados do contrato (quem, quando, valor anterior e novo)",
      "items": {
        "properties": {
          "alterado_em": {
            "format": "date-time",
            "type": "string"
          },
          "alterado_por": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "string"
          },
          "valor_novo": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "included_services": {
      "description": "Servi\u00e7os inclusos",
      "items": {
        "enum": [
          "Manuten\u00e7\u00e3o Preventiva",
          "Manuten\u00e7\u00e3o Corretiva",
          "Pe\u00e7as",
          "Calibra\u00e7\u00e3o"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "monthly_value": {
      "description": "Valor mensal (R$)",
      "type": "number"
    },
    "notes": {
      "description": "Observa\u00e7\u00f5es",
      "type": "string"
    },
    "preventive_frequency": {
      "description": "Periodicidade de manuten\u00e7\u00e3o preventiva inclusa",
      "enum": [
        "Mensal",
        "Trimestral",
        "Semestral",
        "Anual"
      ],
      "type": "string"
    },
    "series_nao_encontradas": {
      "description": "S\u00e9ries do contrato sem equipamento correspondente no cadastro (nunca criar equipamento automaticamente)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "series_no_contrato": {
      "description": "N\u00fameros de s\u00e9rie listados no contrato/anexo, como extra\u00eddos pela IA",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sla_resolution_hours": {
      "description": "Tempo de resolu\u00e7\u00e3o contratual / SLA (horas)",
      "type": "number"
    },
    "sla_response_hours": {
      "description": "Tempo de resposta contratual (horas)",
      "type": "number"
    },
    "start_date": {
      "description": "Data de in\u00edcio de vig\u00eancia",
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "Ativo",
      "description": "Status do contrato",
      "enum": [
        "Ativo",
        "Vencendo",
        "Vencido",
        "Cancelado"
      ],
      "type": "string"
    },
    "supplier_name": {
      "description": "Nome do fornecedor",
      "type": "string"
    },
    "total_value": {
      "description": "Valor total (R$)",
      "type": "number"
    },
    "versoes_documento": {
      "description": "Hist\u00f3rico de vers\u00f5es do PDF. O PDF assinado nunca \u00e9 alterado: corre\u00e7\u00f5es, aditivos e renegocia\u00e7\u00f5es entram como nova vers\u00e3o, preservando as anteriores.",
      "items": {
        "properties": {
          "enviado_em": {
            "format": "date-time",
            "type": "string"
          },
          "enviado_por": {
            "type": "string"
          },
          "nota": {
            "type": "string"
          },
          "tipo": {
            "enum": [
              "Original",
              "Aditivo",
              "Renova\u00e7\u00e3o",
              "Corre\u00e7\u00e3o"
            ],
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "vigente": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "warranty_months": {
      "description": "Prazo de garantia em meses, contado a partir da entrega/instala\u00e7\u00e3o do equipamento (n\u00e3o da assinatura). Equipment.warranty_end s\u00f3 deve ser calculado se Equipment.installation_date existir.",
      "type": "number"
    },
    "warranty_terms": {
      "description": "Termos de garantia",
      "type": "string"
    }
  },
  "required": [
    "supplier_name",
    "contract_number",
    "start_date",
    "end_date"
  ],
  "type": "object"
}